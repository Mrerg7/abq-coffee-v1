---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const STREAM_SRC =
  'https://customer-wa9cpywo3l4jte5c.cloudflarestream.com/9eb81fa273d4c381dee9ad1b27f30526/iframe?muted=true&loop=true&autoplay=true&poster=https%3A%2F%2Fcustomer-wa9cpywo3l4jte5c.cloudflarestream.com%2F9eb81fa273d4c381dee9ad1b27f30526%2Fthumbnails%2Fthumbnail.jpg%3Ftime%3D%26height%3D600&controls=false';

const eyebrow = 'Albuquerque · Roast · Pour · Gather';
const blurb = 'A short, memorable domain for cafes, roasters, and coffee brands in the high desert.';
---

<Layout>
  <Header />

  <main class="flex-1">
    <section class="bg-roast-950">
      {/* Taller frame on mobile so Stream is readable; no text overlay below md. */}
      <div class="relative aspect-[5/4] w-full overflow-hidden md:aspect-[1.843]">
        <iframe
          src={STREAM_SRC}
          title="ABQ.Coffee hero video"
          loading="eager"
          class="absolute inset-0 h-full w-full border-0"
          allow="accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture;"
          allowfullscreen="true"
        ></iframe>
        <div class="pointer-events-none absolute inset-0 hidden bg-gradient-to-t from-roast-950 via-roast-950/55 to-roast-950/20 md:block"></div>
        <div class="absolute inset-0 hidden items-end md:flex">
          <div class="container-narrow w-full pb-10 pt-20">
            <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-roast-200">{eyebrow}</p>
            <h1 class="font-display text-6xl font-semibold leading-none text-white lg:text-7xl">
              ABQ<span class="text-roast-300">.Coffee</span>
            </h1>
            <p class="mt-5 max-w-xl text-lg leading-relaxed text-cream-100/90">{blurb}</p>
            <div class="mt-8 flex flex-row gap-3">
              <a href="#cup" class="btn-primary pointer-events-auto">Explore the Brand</a>
              <a href="#acquisition" class="btn-secondary pointer-events-auto">Domain Available</a>
            </div>
          </div>
        </div>
      </div>
      <div class="border-t border-white/10 md:hidden">
        <div class="container-narrow pb-8 pt-6">
          <p class="mb-2 text-[10px] font-semibold uppercase tracking-[0.2em] text-roast-200">{eyebrow}</p>
          <h1 class="font-display text-4xl font-semibold leading-none text-white">
            ABQ<span class="text-roast-300">.Coffee</span>
          </h1>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-cream-100/90">{blurb}</p>
          <div class="mt-5 flex flex-col gap-2">
            <a href="#cup" class="btn-primary">Explore the Brand</a>
            <a href="#acquisition" class="btn-secondary">Domain Available</a>
          </div>
        </div>
      </div>
    </section>

    <section id="cup" class="section-padding bg-white">
      <div class="container-narrow">
        <div class="max-w-2xl">
          <h2 class="font-display text-3xl font-semibold text-roast-950 sm:text-4xl">The cup comes first</h2>
          <p class="mt-4 text-base text-roast-800 sm:text-lg">
            A coffee brand in Albuquerque has to work at 5,300 feet — for early commuters, campus traffic, and weekend patio hours.
          </p>
        </div>

        <div class="mt-10 grid gap-4 sm:mt-12 sm:gap-6 md:grid-cols-3">
          <article class="card">
            <h3 class="font-display text-xl font-semibold text-roast-950">Cafe</h3>
            <p class="mt-2 text-sm leading-relaxed text-roast-700">
              Neighborhood espresso, drip, and pastry. A name that fits a sandwich board and a maps listing.
            </p>
          </article>
          <article class="card">
            <h3 class="font-display text-xl font-semibold text-roast-950">Roaster</h3>
            <p class="mt-2 text-sm leading-relaxed text-roast-700">
              Bags, wholesale, and subscription. City + category on the label, no extra explanation required.
            </p>
          </article>
          <article class="card">
            <h3 class="font-display text-xl font-semibold text-roast-950">Cart & events</h3>
            <p class="mt-2 text-sm leading-relaxed text-roast-700">
              Markets, studios, and pop-ups. Short enough to print on a cup sleeve.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section id="city" class="section-padding bg-cream-100">
      <div class="container-narrow grid gap-10 lg:grid-cols-2 lg:items-start">
        <div>
          <h2 class="font-display text-3xl font-semibold text-roast-950 sm:text-4xl">Made for the high desert</h2>
          <p class="mt-4 text-base text-roast-800 sm:text-lg">
            Dry air, bright mornings, and a cafe scene that stretches from Nob Hill to the West Side. The domain matches the city people already type.
          </p>
          <ul class="mt-8 space-y-4 text-sm text-roast-800 sm:text-base">
            <li class="flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-roast-500"></span><span><strong class="text-roast-950">Local search intent</strong> — ABQ plus coffee is how visitors and residents look for a shop.</span></li>
            <li class="flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-roast-500"></span><span><strong class="text-roast-950">Altitude-aware brewing</strong> — extraction and recipes behave differently above 5,000 feet.</span></li>
            <li class="flex gap-3"><span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-roast-500"></span><span><strong class="text-roast-950">All-day format</strong> — morning espresso through afternoon patio pours.</span></li>
          </ul>
        </div>
        <div class="rounded-2xl border border-roast-100 bg-white p-5 sm:p-8">
          <dl class="space-y-5">
            <div class="flex items-baseline justify-between gap-4 border-b border-roast-100 pb-4">
              <dt class="text-sm text-roast-600">Market</dt>
              <dd class="font-display text-xl font-semibold text-roast-800 sm:text-2xl">Albuquerque</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 border-b border-roast-100 pb-4">
              <dt class="text-sm text-roast-600">Elevation</dt>
              <dd class="font-display text-xl font-semibold text-roast-800 sm:text-2xl">~5,300 ft</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 border-b border-roast-100 pb-4">
              <dt class="text-sm text-roast-600">Brand fit</dt>
              <dd class="font-display text-xl font-semibold text-roast-800 sm:text-2xl">Cafe · Roast · Cart</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-sm text-roast-600">TLD</dt>
              <dd class="font-display text-xl font-semibold text-roast-800 sm:text-2xl">.coffee</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section id="brand" class="section-padding bg-white">
      <div class="container-narrow max-w-3xl">
        <h2 class="font-display text-3xl font-semibold text-roast-950 sm:text-4xl">Why this domain</h2>
        <div class="mt-6 space-y-4 text-sm leading-relaxed text-roast-800 sm:text-base">
          <p>
            <strong class="text-roast-950">ABQ.Coffee</strong> is city plus category in six letters and a purpose-built TLD.
            It reads cleanly on a window, a bag, and a search result.
          </p>
          <p>
            Available for a single cafe, a roasting company, or a hospitality group expanding in New Mexico.
          </p>
        </div>
      </div>
    </section>

    <section class="border-t border-roast-100 bg-cream-100 py-10 sm:py-12">
      <div class="container-narrow text-center">
        <p class="mx-auto max-w-2xl text-xs leading-relaxed text-roast-600 sm:text-sm">
          Information presented is for demonstration and educational purposes only and does not constitute an offer of cafe or roasting services.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
