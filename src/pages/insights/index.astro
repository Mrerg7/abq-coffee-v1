---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE } from '../../config/site';

type Insight = CollectionEntry<'insights'>;

const insights = (
  await getCollection('insights', (entry: Insight): entry is Insight => !entry.data.draft)
).sort((a: Insight, b: Insight) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title={`Coffee Insights & Domain Branding | ${SITE.domain}`}
  description={`Practical guides on high-desert brewing, the Albuquerque coffee scene, and how to name a coffee brand — published by the team behind ${SITE.domain}.`}
  canonical="/insights/"
  keywords="Albuquerque coffee, high altitude coffee brewing, coffee brand names, ABQ coffee domain, coffee roasting New Mexico, premium domain branding"
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Insights', path: '/insights/' },
  ]}
>
  <Header />

  <main id="main-content" class="flex-1">
    <section class="border-b border-white/10 bg-roast-950">
      <div class="container-narrow py-16 sm:py-24">
        <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-roast-300">Insights · Coffee · Branding</p>
        <h1 class="mt-3 max-w-3xl font-display text-4xl font-semibold leading-tight text-white sm:text-6xl">
          Coffee insights, from {SITE.name}
        </h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-cream-100/85 sm:text-lg">
          Practical, no-fluff guides on the category the {SITE.domain} domain was built to lead — high-altitude brewing,
          the Albuquerque scene, and the branding decisions behind a coffee name.
        </p>
      </div>
    </section>

    <section class="section-padding bg-white">
      <div class="container-narrow">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {
            insights.map((post: Insight) => (
              <a href={`/insights/${post.slug}/`} class="card group flex flex-col transition hover:-translate-y-1">
                <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-roast-500">
                  {post.data.pubDate.toISOString().split('T')[0]}
                </p>
                <h2 class="mt-3 font-display text-xl font-semibold text-roast-950 group-hover:text-roast-700">
                  {post.data.title}
                </h2>
                <p class="mt-3 text-sm leading-relaxed text-roast-700">{post.data.description}</p>
                <span class="mt-4 text-sm font-medium text-roast-900">Read more →</span>
              </a>
            ))
          }
        </div>

        <div class="mt-14 rounded-2xl border border-roast-100 bg-cream-100 p-6 text-center sm:p-10">
          <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-roast-500">The domain behind the insights</p>
          <p class="mt-3 font-display text-3xl font-semibold text-roast-950 sm:text-4xl">{SITE.domain}</p>
          <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-roast-700">
            City plus category in one hostname — offered at {SITE.priceDisplay}. Built for a coffee brand in Albuquerque
            that intends to rank, not just open.
          </p>
          <a href="/#acquisition" class="btn-primary mt-6">Make an offer</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
