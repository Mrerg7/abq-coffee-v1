---
import { SITE, ACQUISITION_MAILTO } from '../config/site';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-roast-950 text-cream-100">
  <div class="container-narrow py-12 sm:py-14">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="font-display text-xl text-white">
          {SITE.domain} <span class="text-roast-300">for sale</span>
        </p>
        <p class="mt-1 font-display text-2xl font-semibold text-roast-300">{SITE.priceDisplay}</p>
        <p class="mt-1 text-xs uppercase tracking-[0.16em] text-roast-400">Informational platform</p>
        <a
          href={ACQUISITION_MAILTO(`Domain Inquiry: ${SITE.domain}`)}
          class="mt-4 inline-flex min-h-10 items-center rounded-full bg-roast-300 px-5 text-sm font-medium text-roast-950 transition hover:bg-roast-200"
        >
          Make an offer
        </a>
      </div>

      <nav class="grid grid-cols-2 gap-x-10 gap-y-2 text-sm sm:grid-cols-3" aria-label="Footer navigation">
        <a href="/#cup" class="text-roast-200/80 hover:text-roast-300">The Cup</a>
        <a href="/#city" class="text-roast-200/80 hover:text-roast-300">The City</a>
        <a href="/#brand" class="text-roast-200/80 hover:text-roast-300">The Domain</a>
        <a href="/insights/" class="text-roast-200/80 hover:text-roast-300">Coffee Insights</a>
        <a href="/#faq" class="text-roast-200/80 hover:text-roast-300">Buyer FAQ</a>
        <a href="/#acquisition" class="text-roast-200/80 hover:text-roast-300">Domain Inquiry</a>
        <a href={SITE.escrow} rel="noopener nofollow" target="_blank" class="text-roast-200/80 hover:text-roast-300">Escrow.com</a>
        <a href={`mailto:${SITE.email}`} class="text-roast-200/80 hover:text-roast-300">{SITE.email}</a>
      </nav>
    </div>

    <p class="mt-8 max-w-3xl text-xs leading-relaxed text-roast-400">
      This website is for demonstration and informational purposes only. It does not constitute an offer of cafe or
      roasting services, a commitment to deploy, or a guarantee of outcomes. All statistics, projections, and references
      to specific technologies are based on publicly available information as of the date shown and are subject to
      change. {SITE.domain} is offered for sale by its owner; domain sales are completed through Escrow.com.
    </p>

    <div class="mt-8 flex flex-col gap-2 border-t border-white/10 pt-6 text-xs text-roast-500 sm:flex-row sm:justify-between">
      <p>© {currentYear} {SITE.name}. All rights reserved.</p>
      <p>Astro · Cloudflare Workers Static Assets · Stream</p>
    </div>
  </div>
</footer>
